<Window x:Class="ClickWrap.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installer"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="516"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Two layers, as in the store's ThemedDialog: an empty border carries the
         rasterised drop shadow, the content border on top keeps text crisp. -->
    <Grid Margin="18">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="3" Direction="270" Opacity="0.22" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                SnapsToDevicePixels="True">
            <StackPanel Margin="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBadge" Grid.Column="0" Width="36" Height="36"
                            CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Top"
                            Background="{StaticResource AccentSoftBrush}">
                        <TextBlock x:Name="IconGlyph" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" Text="↓" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeadingText" Style="{StaticResource TitleTextStyle}"
                                   FontSize="17" TextWrapping="Wrap" Text="Installing" />
                        <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource SubtitleTextStyle}" Text="Starting…" />
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="Progress" Margin="0,18,0,0" IsIndeterminate="True" />

                <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,20,0,0" Visibility="Collapsed">
                    <Button x:Name="CloseButton" MinWidth="86" Content="Close" Click="CloseButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
