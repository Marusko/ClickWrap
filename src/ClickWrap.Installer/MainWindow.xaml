<Window x:Class="ClickWrap.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installer"
        Icon="appicon.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="516"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Muted by default; the theme's hover triggers still bring it to the accent colour. -->
        <Style x:Key="CreditLinkStyle" TargetType="Hyperlink" BasedOn="{StaticResource {x:Type Hyperlink}}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>


    <!-- Two layers, as in the store's ThemedDialog: an empty border carries the
         rasterised drop shadow, the content border on top keeps text crisp. -->
    <Grid Margin="18">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="3" Direction="270" Opacity="0.22" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                SnapsToDevicePixels="True">
            <StackPanel Margin="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBadge" Grid.Column="0" Width="36" Height="36"
                            CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Top"
                            Background="{StaticResource AccentSoftBrush}">
                        <TextBlock x:Name="IconGlyph" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" Text="↓" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeadingText" Style="{StaticResource TitleTextStyle}"
                                   FontSize="17" TextWrapping="Wrap" Text="Installing" />
                        <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource SubtitleTextStyle}" Text="Starting…" />
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="Progress" Margin="0,18,0,0" IsIndeterminate="True" />

                <Grid Margin="0,20,0,0">
                    <!-- Attribution required by the icon licence. Deliberately quiet: it sits on
                         the footer line the button already occupies, so it costs no extra height. -->
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"
                               FontSize="10.5" Opacity="0.75">
                        <Hyperlink NavigateUri="https://www.axialis.com"
                                   Style="{StaticResource CreditLinkStyle}"
                                   RequestNavigate="Hyperlink_RequestNavigate">Icons courtesy of Axialis Software</Hyperlink>
                    </TextBlock>

                    <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="Collapsed">
                        <Button x:Name="CloseButton" MinWidth="86" Content="Close" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
