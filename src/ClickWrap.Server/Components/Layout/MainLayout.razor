@inherits LayoutComponentBase

<MudThemeProvider Theme="ClickWrapTheme.Instance" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Surface" Class="border-b">
        <MudText Typo="Typo.h6" Class="mr-8">ClickWrap</MudText>
        <MudButton Href="/" StartIcon="@Icons.Material.Outlined.Apps" Color="Color.Inherit" Class="mr-2">Apps</MudButton>
        <MudButton Href="/admin" StartIcon="@Icons.Material.Outlined.CloudUpload" Color="Color.Inherit">Publish</MudButton>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
