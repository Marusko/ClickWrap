@page "/"
@using ClickWrap.Server.Storage
@inject AppStore Store

<PageTitle>ClickWrap</PageTitle>

<h1>ClickWrap</h1>
<p class="text-secondary">Hosts zipped ClickOnce publish output for the installer to download.</p>

<h2 class="h5">Apps</h2>
@if (_apps.Count == 0)
{
    <p class="text-secondary">Nothing published yet. Go to <a href="admin">Publish</a> to upload a version.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr><th>App id</th><th>Latest</th><th>Versions</th></tr>
        </thead>
        <tbody>
            @foreach (var app in _apps)
            {
                <tr>
                    <td><code>@app.AppId</code></td>
                    <td>@(app.Latest?.Version ?? "—")</td>
                    <td>@app.Count</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AppSummary> _apps = [];

    protected override void OnInitialized()
    {
        _apps = Store.GetAppIds()
            .Select(id =>
            {
                var versions = Store.GetVersions(id);
                return new AppSummary(id, versions.FirstOrDefault(), versions.Count);
            })
            .ToList();
    }

    private sealed record AppSummary(string AppId, VersionEntry? Latest, int Count);
}
