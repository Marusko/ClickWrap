@page "/admin"
@using ClickWrap.Server.Storage
@inject AppStore Store
@inject StatsStore Stats
@inject ServerOptions Options
@inject ISnackbar Snackbar
@inject ILogger<Admin> Logger

<PageTitle>Publish a version</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Publish a version</MudText>
<MudText Typo="Typo.body2" Class="mb-6 mud-text-secondary">
    Upload the zipped ClickOnce publish folder. Zip the <em>contents</em> of the publish folder,
    so <code>setup.exe</code> sits at the root of the archive.
</MudText>

<MudGrid Spacing="6">
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-6" Elevation="0" Outlined="true">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true"
                          CloseIconClicked="() => _error = null">
                    @_error
                </MudAlert>
            }

            <MudSelect T="string" Value="_selectedApp" ValueChanged="OnAppChanged" Label="App"
                       Variant="Variant.Outlined" Class="mb-4">
                <MudSelectItem T="string" Value="@NewAppSentinel">&lt;new app&gt;</MudSelectItem>
                @foreach (var id in _appIds)
                {
                    <MudSelectItem T="string" Value="@id">@id</MudSelectItem>
                }
            </MudSelect>

            @if (_selectedApp == NewAppSentinel)
            {
                <MudTextField @bind-Value="_newAppId" Label="New app id" Variant="Variant.Outlined"
                              Placeholder="race-timer" Immediate="true" Class="mb-4"
                              HelperText="Letters, digits, dot, dash or underscore. Permanent — installers are built against it." />
            }

            <MudTextField @bind-Value="_version" Label="Version" Variant="Variant.Outlined"
                          Placeholder="1.2.3.0" Immediate="true" Class="mb-4"
                          HelperText="Must match the ClickOnce publish version." />

            <MudTextField @bind-Value="_releaseNotes" Label="Release notes (optional)"
                          Variant="Variant.Outlined" Lines="4" Class="mb-4" />

            <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".zip"
                           MaxFileSize="Options.MaxUploadBytes" Class="mb-2">
                <CustomContent Context="upload">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.AttachFile"
                               OnClick="@(() => upload.OpenFilePickerAsync())">
                        @(_file?.Name ?? "Choose publish zip")
                    </MudButton>
                </CustomContent>
            </MudFileUpload>

            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-4">
                @(_file is not null ? $"{FormatSize(_file.Size)} — " : "")Maximum @(Options.MaxUploadBytes / 1024 / 1024) MB.
            </MudText>

            <MudCheckBox T="bool" @bind-Value="_overwrite" Label="Overwrite if this version already exists"
                         Color="Color.Primary" Class="mb-4" />

            @if (_busy)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UploadAsync"
                       Disabled="@(_busy || _file is null)" StartIcon="@Icons.Material.Outlined.CloudUpload">
                @(_busy ? "Uploading…" : "Publish")
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudText Typo="Typo.h6" GutterBottom="true">Published versions</MudText>

        @if (_selectedApp == NewAppSentinel)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Pick an app to see its versions.</MudText>
        }
        else if (_versions.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Nothing published yet.</MudText>
        }
        else
        {
            <MudPaper Elevation="0" Outlined="true">
                <MudTable Items="_versions" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.None">
                    <HeaderContent>
                        <MudTh>Version</MudTh>
                        <MudTh>Uploaded (UTC)</MudTh>
                        <MudTh Style="text-align:right">Size</MudTh>
                        <MudTh Style="text-align:right">Downloads</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Version">
                            @context.Version
                            @if (ReferenceEquals(context, _versions[0]))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                         Variant="Variant.Text" Class="ml-1">latest</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Uploaded">@context.Metadata.UploadedUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</MudTd>
                        <MudTd DataLabel="Size" Style="text-align:right">@FormatSize(context.Metadata.SizeBytes)</MudTd>
                        <MudTd DataLabel="Downloads" Style="text-align:right">@_stats.DownloadsOf(context.Version)</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                @_stats.TotalDownloads downloads in total@(_stats.LastDownloadUtc is null
                    ? "."
                    : $", last on {_stats.LastDownloadUtc.Value.UtcDateTime:yyyy-MM-dd HH:mm} UTC.")
            </MudText>
        }
    </MudItem>
</MudGrid>

@code {
    private const string NewAppSentinel = " new";

    private static readonly AppStats EmptyStats = new() { AppId = "" };

    private IReadOnlyList<string> _appIds = [];
    private IReadOnlyList<VersionEntry> _versions = [];
    private AppStats _stats = EmptyStats;
    private string _selectedApp = NewAppSentinel;
    private string _newAppId = "";
    private string _version = "";
    private string _releaseNotes = "";
    private bool _overwrite;
    private bool _busy;
    private string? _error;
    private IBrowserFile? _file;

    protected override void OnInitialized() => _appIds = Store.GetAppIds();

    private void OnAppChanged(string value)
    {
        _selectedApp = value;
        _error = null;
        RefreshVersions();
    }

    private void RefreshVersions()
    {
        var isNewApp = _selectedApp == NewAppSentinel;
        _versions = isNewApp ? [] : Store.GetVersions(_selectedApp);
        _stats = isNewApp ? EmptyStats : Stats.GetStats(_selectedApp);
    }

    private void OnFileSelected(IBrowserFile? file)
    {
        _file = file;
        _error = null;
    }

    private async Task UploadAsync()
    {
        var appId = _selectedApp == NewAppSentinel ? _newAppId.Trim() : _selectedApp;

        if (!AppStore.IsValidSegment(appId))
        {
            _error = "Enter a valid app id: letters, digits, dot, dash or underscore.";
            return;
        }

        if (!Version.TryParse(_version.Trim(), out _))
        {
            _error = "Enter a valid version number, for example 1.2.3.0.";
            return;
        }

        if (_file is null)
        {
            _error = "Choose the publish zip first.";
            return;
        }

        if (_file.Size > Options.MaxUploadBytes)
        {
            _error = $"That file is {FormatSize(_file.Size)}, over the {Options.MaxUploadBytes / 1024 / 1024} MB limit.";
            return;
        }

        _busy = true;
        _error = null;

        try
        {
            await using var stream = _file.OpenReadStream(Options.MaxUploadBytes);
            var metadata = await Store.SaveVersionAsync(appId, _version.Trim(), stream, _releaseNotes, _overwrite);

            _selectedApp = appId;
            _appIds = Store.GetAppIds();
            RefreshVersions();

            Snackbar.Add($"Published {appId} {metadata.Version} ({FormatSize(metadata.SizeBytes)}).", Severity.Success);

            _file = null;
            _version = "";
            _releaseNotes = "";
            _overwrite = false;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            // Expected validation failures: the message is written for a human.
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Upload of {AppId} {Version} failed.", appId, _version);
            _error = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / 1024d / 1024d:0.#} MB",
        >= 1024 => $"{bytes / 1024d:0.#} KB",
        _ => $"{bytes} B",
    };
}
